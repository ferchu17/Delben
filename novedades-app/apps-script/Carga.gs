/**
 * ============================================================
 * CARGA INICIAL: Agosto - Septiembre 2026
 * ============================================================
 * Servicios y planilla sacados de los Excel de los supervisores
 * (Vica, Scarabetta, Sandoval) y de las conformaciones horarias.
 * Las celdas grises quedaron como noche, las celestes como tarde
 * y los comentarios del Excel quedaron en cada celda.
 *
 * Se carga desde la app (Administración ve un botón cuando la base
 * está vacía) o ejecutando cargarDatosIniciales() en el editor.
 * Reemplaza Servicios y la planilla de ese período. El personal no
 * se carga: se lee de SGI.
 * ============================================================
 */

function cargarDatosIniciales() {
  var D = DATOS_AGO_SEP_2026;
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    // Códigos: la lista de RR.HH.
    reescribir_('Codigos', CODIGOS_INICIALES.map(function (c) {
      return { Codigo: c[0], Descripcion: c[1], Tipo: c[2], Activo: 'SI' };
    }));

    // Servicios
    var DIAS = ['LUN', 'MAR', 'MIE', 'JUE', 'VIE', 'SAB', 'DOM'];
    var servicios = D.servicios.map(function (r) {
      var s = { Id: r[0], Cliente: r[1], Servicio: r[2], Municipio: '', Empresa: r[3], Supervisor: r[4],
        JefeOperaciones: '', Ciclo: r[5], Activo: r[6] };
      var dd = r[7].split('~'), nn = r[8].split('~');
      DIAS.forEach(function (k, i) { s['D_' + k] = dd[i] || '0'; s['N_' + k] = nn[i] || '0'; });
      return s;
    });
    reescribir_('Servicios', servicios);

    // Planilla: nombre y empresa se toman de SGI cuando el legajo existe.
    var porLegajo = {};
    personalSGI_().forEach(function (p) { porLegajo[p.Legajo] = p; });
    var orden = {};
    var ahora = ahora_();
    var filas = D.planilla.map(function (r) {
      var seccion = r[1] === 'R' ? 'RETEN' : 'COBERTURA';
      var k = r[0] + '|' + seccion;
      orden[k] = (orden[k] || 0) + 1;
      var p = r[2] ? porLegajo[r[2]] : null;
      var f = {
        Periodo: D.periodo, ServicioId: r[0], Seccion: seccion, Orden: String(orden[k]),
        Legajo: r[2], Nombre: p ? p.Nombre : r[3], Empresa: p ? p.Empresa : '',
        Puesto: r[4], Turno: '', ActualizadoPor: 'carga inicial', Actualizado: ahora
      };
      var dias = expandirDias_(r[5]);
      DIAS_COL.forEach(function (c, i) { f[c] = dias[i] || ''; });
      return f;
    });
    var resto = leer_('Planilla').filter(function (f) { return f.Periodo !== D.periodo; });
    reescribir_('Planilla', resto.concat(filas));

    var res = { servicios: servicios.length, filas: filas.length, periodo: D.periodo };
    Logger.log('Carga terminada: ' + JSON.stringify(res));
    return res;
  } finally {
    lock.releaseLock();
  }
}

// "12N*3~F~8" -> ["12N","12N","12N","F","8"]
function expandirDias_(txt) {
  var out = [];
  if (!txt) return out;
  txt.split('~').forEach(function (v) {
    var m = v.indexOf('|') < 0 ? v.match(/^(.*)\*(\d+)$/) : null;
    if (m) { for (var i = 0; i < Number(m[2]); i++) out.push(m[1]); }
    else out.push(v);
  });
  return out;
}

