  <!-- PASO 3: INSPECCIÓN TÉCNICA -->
  <div id="pantalla-inspeccion" class="hidden">
    <div class="topbar"><span class="back-arrow" onclick="volverADatos()">←</span><span>Delben | Gestión Integral</span></div>
    <div class="page-title">Nueva Inspección</div>
    <div class="nav-row">
      <button class="btn-back" onclick="volverADatos()">← Volver</button>
      <span class="badge"><span class="dot"></span>Unidad Activa</span>
    </div>

    <div class="card">
      <div class="card-head">
        <div>
          <div class="tag-pill">Control de Móviles</div>
          <div class="card-title" id="inspeccion-titulo">Controles del Vehículo</div>
          <div class="card-subtitle" id="inspeccion-subtitulo"><span>🔧</span><span>Inspección técnica de la unidad</span></div>
        </div>
        <div class="chip-ok" onclick="toggleTodoOK()">⇄ Todo OK</div>
      </div>
    </div>

    <div id="items-inspeccion"></div>

    <div class="card">
      <div class="field">
        <label id="novedad-titulo">Novedad<span class="opt">Opcional</span></label>
        <textarea id="form-novedad" rows="3" maxlength="500" placeholder="Detalle cualquier novedad observada..." oninput="actualizarContadorNovedad()"></textarea>
        <div class="counter"><span id="novedad-contador">0</span>/500</div>
        <div class="helper">Obligatorio solo si existe algún ítem "Con Novedad"</div>
      </div>
    </div>

    <div class="card">
      <div class="tag-pill" style="margin-bottom:2px;">📷 Vistas Fotográficas</div>
      <div class="fotos-caption">Hasta 4 fotos · Máximo 5MB por foto</div>
      <div class="fotos-grid" id="fotos-grid"></div>
    </div>

    <button class="btn btn-success" id="btn-guardar" onclick="guardarFormularioFinal()">💾 Guardar Control</button>
    <button class="btn btn-secondary" onclick="limpiarTodo()">↻ Limpiar Todo</button>
    <div class="footer-credit">Creado por Fernando Jacyno | v2.4</div>
  </div>

</div>

<div id="modal-backdrop" class="modal-backdrop hidden">
  <div class="modal-card">
    <div class="modal-icon">✅</div>
    <div class="modal-title">Datos Guardados Exitosamente</div>
    <div class="modal-sub">Cargado por: <b id="modal-nombre-cargado"></b></div>
    <button class="btn btn-primary" onclick="cerrarModalExito()">Aceptar</button>
  </div>
</div>

<script>
  var DB_DATOS = { personal: [], objetivos: [], flota: [] };
  var FOTOS_BASE64 = [null, null, null, null];
  var TIPO_ACTUAL = '';
  var MAX_FOTO_MB = 5;

  var ITEMS_AUTO = [
    {n:"Estado Externo General", ic:"🚗"}, {n:"Interior (Butacas)", ic:"💺"}, {n:"Luces", ic:"💡"},
    {n:"Neumático Delantero Der.", ic:"🛞"}, {n:"Neumático Delantero Izq.", ic:"🛞"},
    {n:"Neumático Trasero Der.", ic:"🛞"}, {n:"Neumático Trasero Izq.", ic:"🛞"},
    {n:"Rueda de Auxilio", ic:"⭕"}, {n:"Escobillas Parabrisas", ic:"💧"},
    {n:"Luces Bajas", ic:"🔅"}, {n:"Luces Altas", ic:"🔆"},
    {n:"Luz Trasera Izq.", ic:"🔦"}, {n:"Luz Trasera Der.", ic:"🔦"},
    {n:"Luces de Giro", ic:"↩️"}, {n:"Bocina", ic:"📢"},
    {n:"Limpieza Int./Ext.", ic:"🧽"}, {n:"Baliza Lumínica", ic:"⚠️"}, {n:"Ploteos", ic:"🖼️"}
  ];
  var ITEMS_BICI = [
    {n:"Manubrio", ic:"🚲"}, {n:"Freno Delantero", ic:"🛑"}, {n:"Freno Trasero", ic:"🛑"},
    {n:"Guardabarros", ic:"🛡️"}, {n:"Pedales", ic:"🦶"}, {n:"Cargador", ic:"🔌"},
    {n:"Pie de Apoyo", ic:"🦯"}, {n:"Acelerador", ic:"⚡"}, {n:"Asiento", ic:"🪑"}, {n:"Pintura", ic:"🎨"}
  ];
  var FOTOS_LABELS_AUTO = ["Vista Frontal", "Lateral Izq.", "Lateral Der.", "Vista Trasera"];
  var FOTOS_LABELS_BICI = ["Vista 1", "Vista 2", "Vista 3", "Vista 4"];
  var FOTOS_GRID_TIPO_RENDERIZADO = null;

  window.onload = function() {
    var hoy = new Date();
    document.getElementById('form-fecha').value = hoy.toISOString().split('T')[0];
    var hh = String(hoy.getHours()).padStart(2, '0');
    var mm = String(hoy.getMinutes()).padStart(2, '0');
    document.getElementById('form-hora').value = hh + ':' + mm;
    renderFotosGrid();
    if (typeof google !== 'undefined' && google.script && google.script.run) {
      google.script.run.withSuccessHandler(function(res) {
        if (res) { DB_DATOS = res; poblarListas(); }
      }).getDatosControlMoviles();
    }
  };

  function poblarListas() {
    var dlPer = document.getElementById('dl-personal');
    dlPer.innerHTML = DB_DATOS.personal.map(function(p){ return '<option value="'+p.nombre+'">'; }).join('');
    var dlObj = document.getElementById('dl-objetivos');
    dlObj.innerHTML = DB_DATOS.objetivos.map(function(o){ return '<option value="'+o+'">'; }).join('');
    var dlFlo = document.getElementById('dl-flota');
    dlFlo.innerHTML = DB_DATOS.flota.map(function(f){ return '<option value="'+f.patente+'">'+f.movil+'</option>'; }).join('');
  }

  function autocompletarPersonal() {
    var val = document.getElementById('form-personal').value.trim().toLowerCase();
    var p = DB_DATOS.personal.find(function(x){ return x.nombre.toLowerCase() === val; });
    if (p) {
      document.getElementById('form-dni').value = p.dni || '';
      document.getElementById('form-legajo').value = p.legajo || '';
      document.getElementById('form-empresa').value = p.empresa || '';
    }
  }

  function autocompletarMovil() {
    var pat = document.getElementById('form-patente').value.trim().toUpperCase();
    var f = DB_DATOS.flota.find(function(x){ return x.patente.toUpperCase() === pat; });
    document.getElementById('form-movil').value = f ? f.movil : '';
  }

  /* ---- Selector de tipo ---- */
  function seleccionarTipoChip(tipo) {
    TIPO_ACTUAL = tipo;
    ['Bicicleta','Combustible','Eléctrico'].forEach(function(t){
      document.getElementById('chip-' + t).classList.toggle('selected', t === tipo);
    });
    irADatos();
  }
  function irADatos() {
    if (!TIPO_ACTUAL) { alert('Por favor seleccioná un tipo de móvil'); return; }
    document.getElementById('pantalla-tipo').classList.add('hidden');
    document.getElementById('pantalla-datos').classList.remove('hidden');
    document.getElementById('datos-titulo').textContent = 'Control de Móviles - ' + TIPO_ACTUAL;
    document.getElementById('bloque-auto').classList.toggle('hidden', TIPO_ACTUAL === 'Bicicleta');
    document.getElementById('bloque-patente-movil').classList.toggle('hidden', TIPO_ACTUAL === 'Eléctrico');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function volverATipo() {
    document.getElementById('pantalla-datos').classList.add('hidden');
    document.getElementById('pantalla-tipo').classList.remove('hidden');
  }
  function limpiarFormularioDatos() {
    document.getElementById('form-patente').value = '';
    document.getElementById('form-movil').value = '';
    document.getElementById('form-km').value = '';
    document.getElementById('form-objetivo').value = '';
    document.getElementById('form-turno').value = '';
    document.getElementById('form-personal').value = '';
    document.getElementById('form-dni').value = '';
    document.getElementById('form-legajo').value = '';
    document.getElementById('form-empresa').value = '';
  }

  /* ---- Inspección ---- */
  function irAInspeccion() {
    var per = document.getElementById('form-personal').value.trim();
    var obj = document.getElementById('form-objetivo').value.trim();
    if (!per || !obj) {
      alert('Por favor completá Objetivo y Personal antes de continuar');
      return;
    }
    var esBici = (TIPO_ACTUAL === 'Bicicleta');
    var items = esBici ? ITEMS_BICI : ITEMS_AUTO;
    document.getElementById('inspeccion-titulo').textContent = esBici ? 'Controles Bicicleta Eléctrica' : 'Controles del Vehículo';
    document.getElementById('inspeccion-subtitulo').innerHTML = esBici
      ? '<span>🔧</span><span>Inspección técnica de la unidad · Bicicletas Eléctricas</span>'
      : '<span>🔧</span><span>Inspección técnica de la unidad · Combustible / Carros Eléctricos</span>';
    document.getElementById('novedad-titulo').innerHTML = (esBici ? 'Novedad Bicicleta' : 'Novedad Vehículo') + '<span class="opt">Opcional</span>';

    var cont = document.getElementById('items-inspeccion');
    cont.innerHTML = items.map(function(it, idx) {
      return '<div class="item-card">' +
        '<div class="item-head"><div class="item-head-left">' +
        '<div class="item-ic">' + it.ic + '</div>' +
        '<div class="item-label">' + (idx + 1) + '. ' + it.n + '</div>' +
        '</div><div class="item-dot" id="dot-' + idx + '"></div></div>' +
        '<select class="ctrl-item" data-item="' + it.n + '" onchange="actualizarDot(' + idx + ', this.value)">' +
        '<option value="">-</option>' +
        '<option value="Sin Novedad">Sin Novedad</option>' +
        '<option value="Con Novedad">Con Novedad</option>' +
        '</select></div>';
    }).join('');

    // Solo redibuja (y borra) las fotos si es una entrada nueva a este tipo de móvil;
    // si el usuario vuelve de "Datos" a "Inspección" del mismo control, conserva las fotos ya cargadas
    if (FOTOS_GRID_TIPO_RENDERIZADO !== TIPO_ACTUAL) {
      renderFotosGrid();
      FOTOS_GRID_TIPO_RENDERIZADO = TIPO_ACTUAL;
    }
    document.getElementById('form-novedad').value = '';
    actualizarContadorNovedad();
    document.getElementById('pantalla-datos').classList.add('hidden');
    document.getElementById('pantalla-inspeccion').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function volverADatos() {
    document.getElementById('pantalla-inspeccion').classList.add('hidden');
    document.getElementById('pantalla-datos').classList.remove('hidden');
  }
  function actualizarDot(idx, valor) {
    var dot = document.getElementById('dot-' + idx);
    dot.classList.remove('ok', 'novedad');
    if (valor === 'Sin Novedad') dot.classList.add('ok');
    else if (valor === 'Con Novedad') dot.classList.add('novedad');
  }
  function toggleTodoOK() {
    document.querySelectorAll('.ctrl-item').forEach(function(sel, idx) {
      sel.value = 'Sin Novedad';
      actualizarDot(idx, 'Sin Novedad');
    });
  }
  function actualizarContadorNovedad() {
    var val = document.getElementById('form-novedad').value;
    document.getElementById('novedad-contador').textContent = val.length;
  }

  /* ---- Fotos ---- */
  function renderFotosGrid() {
    var labels = (TIPO_ACTUAL === 'Bicicleta') ? FOTOS_LABELS_BICI : FOTOS_LABELS_AUTO;
    var grid = document.getElementById('fotos-grid');
    grid.innerHTML = labels.map(function(lbl, idx) {
      return '<div class="foto-box">' +
        '<div class="foto-label">' + lbl + '</div>' +
        '<div class="foto-preview" id="preview-' + idx + '">📷</div>' +
        '<div class="sin-img" id="sinimg-' + idx + '">Sin imagen</div>' +
        '<div class="foto-btns">' +
        '<button type="button" onclick="clickSlot(' + idx + ', false)">📁 Archivo</button>' +
        '<button type="button" onclick="clickSlot(' + idx + ', true)">📷 Cámara</button>' +
        '</div>' +
        '<input type="file" id="file-' + idx + '" accept="image/*" style="display:none" onchange="cargarFoto(' + idx + ', this)">' +
        '</div>';
    }).join('');
    FOTOS_BASE64 = [null, null, null, null];
  }
  function clickSlot(idx, camara) {
    var input = document.getElementById('file-' + idx);
    if (camara) input.setAttribute('capture', 'environment');
    else input.removeAttribute('capture');
    input.click();
  }
  function cargarFoto(idx, input) {
    var file = input.files[0];
    if (!file) return;
    if (file.size > MAX_FOTO_MB * 1024 * 1024) {
      alert('La foto supera los ' + MAX_FOTO_MB + 'MB permitidos');
      input.value = '';
      return;
    }
    var reader = new FileReader();
    reader.onload = function(e) {
      var base64 = e.target.result.split(',')[1];
      FOTOS_BASE64[idx] = { base64: base64, mimeType: file.type, name: file.name };
      document.getElementById('preview-' + idx).innerHTML =
        '<img src="' + e.target.result + '"><button type="button" class="del" onclick="event.stopPropagation(); borrarFoto(' + idx + ')">×</button>';
      document.getElementById('sinimg-' + idx).classList.add('hidden');
    };
    reader.readAsDataURL(file);
  }
  function borrarFoto(idx) {
    FOTOS_BASE64[idx] = null;
    document.getElementById('preview-' + idx).innerHTML = '📷';
    document.getElementById('sinimg-' + idx).classList.remove('hidden');
    document.getElementById('file-' + idx).value = '';
  }
  function limpiarTodo() {
    document.querySelectorAll('.ctrl-item').forEach(function(sel, idx) { sel.value = ''; actualizarDot(idx, ''); });
    document.getElementById('form-novedad').value = '';
    actualizarContadorNovedad();
    renderFotosGrid();
  }

  /* ---- Guardado ---- */
  function guardarFormularioFinal() {
    var hayNovedad = false;
    document.querySelectorAll('.ctrl-item').forEach(function(sel) { if (sel.value === 'Con Novedad') hayNovedad = true; });
    var nov = document.getElementById('form-novedad').value.trim();
    if (hayNovedad && !nov) {
      alert('Hay ítems marcados "Con Novedad": por favor detallá la novedad antes de guardar');
      return;
    }

    var btn = document.getElementById('btn-guardar');
    btn.disabled = true;
    btn.textContent = '⏳ Guardando...';

    var fecha = document.getElementById('form-fecha').value;
    var hora = document.getElementById('form-hora').value;
    var dia = new Date(fecha + 'T00:00:00').toLocaleDateString('es-AR', { weekday: 'long' });
    var per = document.getElementById('form-personal').value;
    var dni = document.getElementById('form-dni').value;
    var leg = document.getElementById('form-legajo').value;
    var turno = document.getElementById('form-turno').value;
    var obj = document.getElementById('form-objetivo').value;
    var pat = document.getElementById('form-patente').value;
    var mov = document.getElementById('form-movil').value;
    var km = document.getElementById('form-km').value;

    var controles = [];
    document.querySelectorAll('.ctrl-item').forEach(function(sel) { controles.push(sel.value); });

    var fila = [];
    if (TIPO_ACTUAL === 'Bicicleta') {
      fila = ['', fecha, dia, hora, per, dni, leg, turno, obj, TIPO_ACTUAL].concat(controles).concat([nov, '']);
    } else {
      fila = ['', fecha, dia, hora, per, dni, leg, turno, obj, TIPO_ACTUAL, (pat + ' (' + mov + ')').trim(), km].concat(controles).concat([nov, '']);
    }
    var fotosEnvio = FOTOS_BASE64.filter(function(f){ return f !== null; });

    google.script.run
      .withSuccessHandler(function(res) {
        mostrarModalExito(per);
      })
      .withFailureHandler(function(err) {
        alert('❌ Error al guardar: ' + (err.message || err));
        btn.disabled = false;
        btn.textContent = '💾 Guardar Control';
      })
      .guardarControlCompleto(TIPO_ACTUAL, fila, fotosEnvio);
  }

  /* ---- Modal de éxito y reseteo sin recargar la página ---- */
  function mostrarModalExito(nombre) {
    document.getElementById('modal-nombre-cargado').textContent = nombre || '';
    document.getElementById('modal-backdrop').classList.remove('hidden');
  }
  function cerrarModalExito() {
    document.getElementById('modal-backdrop').classList.add('hidden');
    resetearAppCompleta();
  }
  function resetearAppCompleta() {
    TIPO_ACTUAL = '';
    FOTOS_GRID_TIPO_RENDERIZADO = null;
    ['Bicicleta','Combustible','Eléctrico'].forEach(function(t){
      document.getElementById('chip-' + t).classList.remove('selected');
    });
    limpiarFormularioDatos();
    limpiarTodo();

    var btn = document.getElementById('btn-guardar');
    btn.disabled = false;
    btn.textContent = '💾 Guardar Control';

    document.getElementById('pantalla-inspeccion').classList.add('hidden');
    document.getElementById('pantalla-datos').classList.add('hidden');
    document.getElementById('pantalla-tipo').classList.remove('hidden');

    var hoy = new Date();
    document.getElementById('form-fecha').value = hoy.toISOString().split('T')[0];
    var hh = String(hoy.getHours()).padStart(2, '0');
    var mm = String(hoy.getMinutes()).padStart(2, '0');
    document.getElementById('form-hora').value = hh + ':' + mm;

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>
</body>
</html>
`;
}