function prop_(name) { return PropertiesService.getScriptProperties().getProperty(name) || ''; }
function setProp_(name, v) { PropertiesService.getScriptProperties().setProperty(name, String(v)); }

function norm_(s) {
  return String(s == null ? '' : s).normalize('NFD').replace(/[̀-ͯ]/g, '')
    .toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
}

function esc_(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function limpiar_(s, max) {
  return String(s == null ? '' : s).replace(/[\u0000-\u0009\u000b-\u001f]/g, ' ').trim().slice(0, max || 200);
}

function soloDigitos_(s) { return String(s == null ? '' : s).replace(/\D/g, ''); }

const RE_MAIL_ = /^[^@\s,;]+@[^@\s,;]+\.[^@\s,;]+$/;

function hoja_(ss, nombre) {
  const n = norm_(nombre);
  const hojas = ss.getSheets();
  for (let i = 0; i < hojas.length; i++) if (norm_(hojas[i].getName()) === n) return hojas[i];
  throw new Error('No existe la solapa "' + nombre + '". Solapas encontradas: ' +
    hojas.map(function (h) { return h.getName(); }).join(', '));
}

function hojaOCrear_(ss, nombre, filasIniciales) {
  let sh = null;
  try { sh = hoja_(ss, nombre); } catch (e) { sh = null; }
  if (!sh) sh = ss.insertSheet(nombre);
  if (sh.getLastRow() < 1 && filasIniciales && filasIniciales.length) {
    const ancho = filasIniciales[0].length;
    sh.getRange(1, 1, filasIniciales.length, ancho).setValues(filasIniciales);
    sh.getRange(1, 1, 1, ancho).setFontWeight('bold').setBackground('#0065BC').setFontColor('#ffffff');
    sh.setFrozenRows(1);
  }
  return sh;
}

function licSs_() { return SpreadsheetApp.openById(prop_('LIC_SPREADSHEET_ID') || CFG.LIC_SPREADSHEET_ID); }
function fuenteSs_() { return SpreadsheetApp.openById(prop_('SOURCE_SPREADSHEET_ID') || CFG.SOURCE_SPREADSHEET_ID); }

/** Busca una columna por encabezado: primero coincidencia exacta, luego "contiene". */
function buscarCol_(heads, nombres, usadas) {
  let c, k, nc;
  for (c = 0; c < nombres.length; c++) {
    nc = norm_(nombres[c]);
    for (k = 0; k < heads.length; k++) if (usadas.indexOf(k) < 0 && heads[k] === nc) return k;
  }
  for (c = 0; c < nombres.length; c++) {
    nc = norm_(nombres[c]);
    if (nc.length <= 3) continue;
    for (k = 0; k < heads.length; k++) if (usadas.indexOf(k) < 0 && heads[k] && heads[k].indexOf(nc) >= 0) return k;
  }
  return -1;
}

/** Lee una solapa identificando las columnas por encabezado (ignora mayúsculas y tildes). */
function leerTabla_(sh, defs) {
  const lastR = sh.getLastRow(), lastC = sh.getLastColumn();
  if (lastR < 1 || lastC < 1) throw new Error('La solapa "' + sh.getName() + '" está vacía.');
  const v = sh.getRange(1, 1, lastR, lastC).getDisplayValues();
  const claves = Object.keys(defs);
  const maxR = Math.min(v.length, 6);
  for (let r = 0; r < maxR; r++) {
    const heads = v[r].map(norm_);
    const usadas = [], map = {};
    let ok = true;
    for (let j = 0; j < claves.length; j++) {
      const d = defs[claves[j]];
      const i = buscarCol_(heads, d.names, usadas);
      if (i < 0 && d.required) { ok = false; break; }
      map[claves[j]] = i;
      if (i >= 0) usadas.push(i);
    }
    if (ok) return { rows: v.slice(r + 1), map: map, heads: heads, headerRow: r + 1 };
  }
  throw new Error('En la solapa "' + sh.getName() + '" no encontré las columnas: ' +
    claves.filter(function (k) { return defs[k].required; }).map(function (k) { return defs[k].names[0]; }).join(', ') +
    '. Encabezados: ' + (v[0] || []).join(' | '));
}

/* ---------- fechas ---------- */

/** 'yyyy-MM-dd' -> Date (mediodía, para que no se corra por zona horaria). */
function isoAFecha_(iso) {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return null;
  const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), 12, 0, 0);
  return isNaN(d.getTime()) ? null : d;
}

function fechaAIso_(d) {
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
}

function valorAIso_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, CFG.TZ, 'yyyy-MM-dd');
  const s = String(v || '').trim();
  let m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return m[1] + '-' + m[2] + '-' + m[3];
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if (m) return m[3] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[1]).slice(-2);
  return '';
}

function isoAddDias_(iso, n) {
  const d = isoAFecha_(iso);
  d.setDate(d.getDate() + n);
  return fechaAIso_(d);
}

function diasEntre_(desde, hasta) {
  const a = isoAFecha_(desde), b = isoAFecha_(hasta);
  return Math.round((b.getTime() - a.getTime()) / 86400000) + 1;
}

/** '2026-10-05' -> '05 de octubre de 2026' */
function fechaLarga_(iso) {
  const p = String(iso || '').split('-').map(Number);
  if (p.length !== 3 || !p[0]) return '';
  return ('0' + p[2]).slice(-2) + ' de ' + MESES_[p[1] - 1] + ' de ' + p[0];
}

/** '2026-10-05' -> '05/10/2026' */
function fechaCorta_(iso) {
  const p = String(iso || '').split('-');
  return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : '';
}

