/** Ejecutar UNA vez desde el editor: crea hojas, carpetas y verifica permisos. */
function instalar() {
  const ss = licSs_();
  licSheet_();
  hojaOCrear_(ss, CFG.SHEET_TIPOS, [TIPOS_HEADERS].concat(TIPOS_DEFAULT));
  hojaOCrear_(ss, CFG.SHEET_EMPRESAS, EMPRESAS_DEFAULT);
  hojaOCrear_(ss, CFG.SHEET_CONFIG, CONFIG_DEFAULT);
  carpeta_(); carpetaAdj_();
  diagnosticoSistema();
}

function licSheet_() {
  const sh = hojaOCrear_(licSs_(), CFG.SHEET_LICENCIAS, [LIC_HEADERS]);
  // Si la hoja ya existía con menos columnas, se completan los encabezados que falten (al final).
  const lastC = Math.max(sh.getLastColumn(), 1);
  const heads = sh.getRange(1, 1, 1, lastC).getDisplayValues()[0].map(norm_);
  const faltan = LIC_HEADERS.filter(function (h) { return heads.indexOf(norm_(h)) < 0; });
  if (faltan.length) sh.getRange(1, heads.filter(String).length + 1, 1, faltan.length).setValues([faltan]).setFontWeight('bold');
  return sh;
}

/** Mapa encabezado -> índice (0-based) de la hoja Licencias. */
function licCols_(sh) {
  const heads = sh.getRange(1, 1, 1, sh.getLastColumn()).getDisplayValues()[0].map(norm_);
  const m = {};
  LIC_HEADERS.forEach(function (h) { m[h] = heads.indexOf(norm_(h)); });
  return m;
}

function config_() {
  const sh = hojaOCrear_(licSs_(), CFG.SHEET_CONFIG, CONFIG_DEFAULT);
  const v = sh.getDataRange().getDisplayValues();
  const c = {};
  for (let i = 1; i < v.length; i++) {
    const k = String(v[i][0] || '').trim().toUpperCase();
    if (k) c[k] = String(v[i][1] || '').trim();
  }
  return c;
}

function sino_(v, def) {
  const n = norm_(v);
  if (!n) return def;
  if (n === 'si' || n === 's' || n === 'x' || n === 'true' || n === 'obligatorio' || n === 'obligatoria') return 'SI';
  if (n === 'opcional') return 'OPCIONAL';
  return 'NO';
}

function tipos_() {
  const sh = hojaOCrear_(licSs_(), CFG.SHEET_TIPOS, [TIPOS_HEADERS].concat(TIPOS_DEFAULT));
  const t = leerTabla_(sh, {
    codigo: { names: ['codigo', 'código'], required: true },
    nombre: { names: ['nombre', 'tipo'], required: true },
    titulo: { names: ['titulo', 'título'], required: false },
    texto: { names: ['texto'], required: false },
    fechas: { names: ['fechas'], required: false },
    periodo: { names: ['periodo', 'período'], required: false },
    certificado: { names: ['certificado'], required: false },
    firma: { names: ['firma empleado', 'firma'], required: false },
    motivo: { names: ['motivo'], required: false },
    objNuevo: { names: ['objetivo nuevo'], required: false },
    activo: { names: ['activo'], required: false }
  });
  const m = t.map;
  const g = function (r, k) { return m[k] >= 0 ? String(r[m[k]] || '').trim() : ''; };
  const lista = [];
  t.rows.forEach(function (r) {
    const codigo = g(r, 'codigo').toUpperCase(), nombre = g(r, 'nombre');
    if (!codigo || !nombre) return;
    if (sino_(g(r, 'activo'), 'SI') === 'NO') return;
    const fechas = (g(r, 'fechas') || 'RANGO').toUpperCase();
    const cert = (g(r, 'certificado') || 'NO').toUpperCase();
    const firma = (g(r, 'firma') || 'SI').toUpperCase();
    lista.push({
      codigo: codigo,
      nombre: nombre,
      titulo: g(r, 'titulo') || ('LICENCIA: ' + nombre.toUpperCase()),
      texto: g(r, 'texto'),
      fechas: fechas === 'DESDE' || fechas === 'NO' ? fechas : 'RANGO',
      periodo: sino_(g(r, 'periodo'), 'NO') === 'SI',
      certificado: cert.indexOf('OBLIG') === 0 ? 'OBLIGATORIO' : (cert.indexOf('OPC') === 0 ? 'OPCIONAL' : 'NO'),
      firmaEmpleado: firma.indexOf('OPC') === 0 ? 'OPCIONAL' : (firma === 'NO' ? 'NO' : 'SI'),
      motivo: sino_(g(r, 'motivo'), 'NO') === 'SI',
      objetivoNuevo: sino_(g(r, 'objNuevo'), 'NO') === 'SI'
    });
  });
  return lista;
}

/** Razón social de la empresa: hoja Empresas de Licencias; si no está, el nombre tal cual. */
function razonSocial_(empresa) {
  const buscada = norm_(empresa);
  if (!buscada) return '';
  try {
    const sh = hojaOCrear_(licSs_(), CFG.SHEET_EMPRESAS, EMPRESAS_DEFAULT);
    const v = sh.getDataRange().getDisplayValues();
    for (let i = 1; i < v.length; i++) if (norm_(v[i][0]) === buscada && String(v[i][1] || '').trim()) return String(v[i][1]).trim();
    for (let i = 1; i < v.length; i++) if (norm_(v[i][1]) === buscada) return String(v[i][1]).trim();
  } catch (e) { Logger.log('Empresas: ' + e.message); }
  return String(empresa).trim();
}

/* ---------- Drive ---------- */

function carpeta_() {
  const id = prop_('DRIVE_FOLDER_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) { /* se borró: se crea de nuevo */ } }
  const it = DriveApp.getFoldersByName(CFG.DRIVE_FOLDER_NAME);
  const f = it.hasNext() ? it.next() : DriveApp.createFolder(CFG.DRIVE_FOLDER_NAME);
  setProp_('DRIVE_FOLDER_ID', f.getId());
  return f;
}

function carpetaAdj_() {
  const id = prop_('DRIVE_ADJ_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) { /* se crea de nuevo */ } }
  const padre = carpeta_();
  const it = padre.getFoldersByName(CFG.DRIVE_ADJ_NAME);
  const f = it.hasNext() ? it.next() : padre.createFolder(CFG.DRIVE_ADJ_NAME);
  setProp_('DRIVE_ADJ_ID', f.getId());
  return f;
}

function compartirLink_(file) {
  try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) { /* política */ }
}

function driveId_(ref) {
  const s = String(ref || '').trim();
  const m = s.match(/\/d\/([\w-]{15,})/) || s.match(/[?&]id=([\w-]{15,})/);
  return m ? m[1] : (/^[\w-]{15,}$/.test(s) ? s : '');
}

/* =========================================================
   AUTENTICACIÓN (mismos usuarios de SGI)
   ========================================================= */

function authDefs_() {
  return {
    id: { names: ['id'], required: false },
    usuario: { names: ['usuario', 'user', 'nombre de usuario'], required: true },
    password: { names: ['password', 'contraseña', 'clave'], required: true },
    nombre: { names: ['nombre', 'nombre y apellido'], required: true },
    email: { names: ['email', 'e-mail', 'mail', 'correo', 'correo electronico'], required: false }
  };
}

function loginUsuario(usuario, password) {
  usuario = String(usuario || '').trim();
  password = String(password || '');
  if (!usuario || !password) throw new Error('Ingresá usuario y contraseña.');

  const cache = CacheService.getScriptCache();
  const kFail = 'LIC_FAIL_' + norm_(usuario).replace(/ /g, '_').slice(0, 100);
  const fallos = Number(cache.get(kFail) || 0);
  if (fallos >= 5) throw new Error('Demasiados intentos fallidos. Esperá 10 minutos y volvé a intentar.');

  const t = leerTabla_(hoja_(fuenteSs_(), CFG.AUTH_SHEET), authDefs_());
  const m = t.map;
  for (let i = 0; i < t.rows.length; i++) {
    const r = t.rows[i];
    const u = String(r[m.usuario] || '').trim();
    if (u && u.toLowerCase() === usuario.toLowerCase() && String(r[m.password] || '') === password) {
      let email = m.email >= 0 ? String(r[m.email] || '').trim() : '';
      if (!email && u.indexOf('@') > 0) email = u;
      const datos = { id: m.id >= 0 ? r[m.id] : '', nombre: String(r[m.nombre] || '').trim() || u, usuario: u, email: email };
      const token = Utilities.getUuid();
      cache.put('LIC_SES_' + token, JSON.stringify(datos), CFG.SESSION_SECONDS);
      cache.remove(kFail);
      return { ok: true, token: token, usuario: datos };
    }
  }
  cache.put(kFail, String(fallos + 1), 600);
  throw new Error('Acceso inválido: usuario o contraseña incorrectos.');
}

function validarSesion_(token) {
  token = String(token || '').trim();
  if (!token) throw new Error('La sesión no es válida. Volvé a iniciar sesión.');
  const dato = CacheService.getScriptCache().get('LIC_SES_' + token);
  if (!dato) throw new Error('La sesión venció. Volvé a iniciar sesión.');
  return JSON.parse(dato);
}

function validarSesion(token) { return { ok: true, usuario: validarSesion_(token) }; }

function cerrarSesion(token) {
  token = String(token || '').trim();
  if (token) CacheService.getScriptCache().remove('LIC_SES_' + token);
  return { ok: true };
}

/* =========================================================
   CATÁLOGOS
   ========================================================= */

function personalDefs_() {
  return {
    lp: { names: ['LP', 'Legajo', 'Legajo Personal', 'Nro Legajo'], required: true },
    dni: { names: ['DNI', 'Documento', 'Nro Documento'], required: true },
    empresa: { names: ['Empresa', 'Compañía', 'Compania'], required: false },
    estado: { names: ['Estado', 'Situación', 'Situacion', 'Status'], required: false },
    nombre: { names: ['Nombre y Apellido', 'Apellido y Nombre', 'Nombre Apellido', 'Apellido Nombre',
      'Nombre completo', 'Empleado', 'Personal', 'Nombre'], required: true },
    apellido: { names: ['Apellido', 'Apellidos'], required: false },
    email: { names: ['Email', 'E-mail', 'Mail', 'Correo', 'Correo electrónico', 'Correo electronico'], required: false }
  };
}

function emailPersonal_(r, m) {
  let e = String(r[CFG.COL_EMAIL_PERSONAL - 1] || '').trim();
  if (e.indexOf('@') < 0 && m.email >= 0) e = String(r[m.email] || '').trim();
  return RE_MAIL_.test(e) ? e : '';
}

function empleados_() {
  const t = leerTabla_(hoja_(fuenteSs_(), CFG.SHEET_PERSONAL), personalDefs_());
  const m = t.map;
  const unirApellido = m.apellido >= 0 && t.heads[m.nombre].indexOf('apellido') < 0;
  const lista = [];
  t.rows.forEach(function (r) {
    let nombre = String(r[m.nombre] || '').trim();
    if (unirApellido) nombre = (String(r[m.apellido] || '').trim() + ' ' + nombre).trim();
    if (!nombre) return;
    if (m.estado >= 0 && norm_(r[m.estado]) === 'baja') return;   // se excluye solo BAJA
    lista.push({
      nombre: nombre,
      lp: String(r[m.lp] || '').trim(),
      dni: String(r[m.dni] || '').trim(),
      empresa: m.empresa >= 0 ? String(r[m.empresa] || '').trim() : '',
      email: emailPersonal_(r, m)
    });
  });
  lista.sort(function (a, b) { return a.nombre.localeCompare(b.nombre, 'es'); });
  return lista;
}

/** Guarda el email en la columna O del empleado (por DNI) en Personal, como hace Cargos. */
function actualizarEmailPersonal_(dni, email) {
  const d = soloDigitos_(dni);
  if (!d || !RE_MAIL_.test(email)) return '';
  const sh = hoja_(fuenteSs_(), CFG.SHEET_PERSONAL);
  const t = leerTabla_(sh, personalDefs_());
  let n = 0;
  for (let i = 0; i < t.rows.length; i++) {
    if (soloDigitos_(t.rows[i][t.map.dni]) !== d) continue;
    if (emailPersonal_(t.rows[i], t.map).toLowerCase() === email.toLowerCase()) continue;
    if (sh.getMaxColumns() < CFG.COL_EMAIL_PERSONAL) sh.insertColumnsAfter(sh.getMaxColumns(), CFG.COL_EMAIL_PERSONAL - sh.getMaxColumns());
    sh.getRange(t.headerRow + 1 + i, CFG.COL_EMAIL_PERSONAL).setValue(email);
    n++;
  }
  return n ? 'Email del vigilador actualizado en el listado de personal.' : '';
}

function objetivos_() {
  const t = leerTabla_(hoja_(fuenteSs_(), CFG.SHEET_OBJETIVOS), { nombre: { names: ['nombre'], required: true } });
  const vistos = {}, lista = [];
  t.rows.forEach(function (r) {
    const n = String(r[t.map.nombre] || '').trim();
    if (n && !vistos[n]) { vistos[n] = true; lista.push(n); }
  });
  lista.sort(function (a, b) { return a.localeCompare(b, 'es'); });
  return lista;
}

function getCatalogos(token) {
  validarSesion_(token);
  const hoy = Utilities.formatDate(new Date(), CFG.TZ, 'yyyy-MM-dd');
  return { empleados: empleados_(), objetivos: objetivos_(), tipos: tipos_(), hoy: hoy };
}

/* =========================================================
   GUARDAR LICENCIA
   ========================================================= */

function siguienteId_(sh, col) {
  const n = sh.getLastRow();
  if (n < 2 || col < 0) return 1;
  const ids = sh.getRange(2, col + 1, n - 1, 1).getValues();
  let max = 0;
  ids.forEach(function (r) { const v = parseInt(String(r[0]).replace(/\D/g, ''), 10); if (!isNaN(v) && v > max) max = v; });
  return max + 1;
}

function firmaValida_(f) {
  return /^data:image\/png;base64,/.test(String(f || '')) && String(f).length < 700000;
}

/** Reemplaza {variables} en el texto del tipo de licencia. */
function armarTexto_(tipo, lic) {
  const vars = {
    dias: lic.dias ? String(lic.dias) : '',
    desde: fechaLarga_(lic.desde), hasta: fechaLarga_(lic.hasta), reintegro: fechaLarga_(lic.reintegro),
    periodo: lic.periodo || '', tipo: tipo.nombre, objetivo: lic.objetivo, objetivoNuevo: lic.objetivoNuevo || '',
    motivo: lic.motivo || '', empleado: lic.nombre, empresa: lic.razon || lic.empresa
  };
  let txt = tipo.texto || ('Se le notifica la novedad "' + tipo.nombre + '"' +
    (lic.desde ? ' desde el {desde}' : '') + (lic.hasta ? ' hasta el {hasta}, ambos días inclusive ({dias} días corridos)' : '') +
    (lic.reintegro && lic.hasta ? ', debiéndose presentar a tomar tareas en su objetivo y horario habitual el día {reintegro}' : '') + '.');
  return txt.replace(/\{(\w+)\}/g, function (all, k) { return Object.prototype.hasOwnProperty.call(vars, k) ? vars[k] : all; });
}

function guardarLicencia(token, d) {
  const usuario = validarSesion_(token);
  d = d || {};

  const tipo = tipos_().filter(function (t) { return t.codigo === String(d.codigo || '').toUpperCase(); })[0];
  if (!tipo) throw new Error('El tipo de licencia no existe o no está activo.');

  const lic = {
    fecha: valorAIso_(d.fecha) || Utilities.formatDate(new Date(), CFG.TZ, 'yyyy-MM-dd'),
    nombre: limpiar_(d.nombre, 150), lp: limpiar_(d.lp, 30), dni: limpiar_(d.dni, 20), empresa: limpiar_(d.empresa, 120),
    objetivo: limpiar_(d.objetivo, 200), codigo: tipo.codigo, tipo: tipo.nombre,
    periodo: tipo.periodo ? limpiar_(d.periodo, 10) : '',
    desde: tipo.fechas !== 'NO' ? valorAIso_(d.desde) : '',
    hasta: tipo.fechas === 'RANGO' ? valorAIso_(d.hasta) : '',
    objetivoNuevo: tipo.objetivoNuevo ? limpiar_(d.objetivoNuevo, 200) : '',
    motivo: tipo.motivo ? limpiar_(d.motivo, 600) : '',
    observaciones: limpiar_(d.observaciones, 600),
    emailEmpleado: limpiar_(d.emailEmpleado, 150),
    supervisor: limpiar_(usuario.nombre || usuario.usuario, 150),
    aclSup: limpiar_(d.aclaracionSup, 150) || limpiar_(usuario.nombre || usuario.usuario, 150),
    aclEmp: limpiar_(d.aclaracionEmp, 150),
    dniEmpFirma: soloDigitos_(d.dniFirmaEmp).slice(0, 9),
    empleadoAusente: d.empleadoAusente === true
  };

  // Validaciones
  if (!lic.nombre || !lic.dni) throw new Error('Elegí el vigilador de la lista.');
  if (!lic.objetivo) throw new Error('Elegí el objetivo.');
  if (tipo.periodo && !/^\d{4}$/.test(lic.periodo)) throw new Error('Elegí el período al que corresponde.');
  if (tipo.fechas !== 'NO' && !lic.desde) throw new Error('Cargá la fecha desde.');
  if (tipo.fechas === 'RANGO') {
    if (!lic.hasta) throw new Error('Cargá la fecha hasta.');
    if (lic.hasta < lic.desde) throw new Error('La fecha hasta no puede ser anterior a la fecha desde.');
    lic.dias = diasEntre_(lic.desde, lic.hasta);
    if (lic.dias > 366) throw new Error('El rango de fechas supera un año. Revisá las fechas.');
    lic.reintegro = isoAddDias_(lic.hasta, 1);
  } else { lic.dias = ''; lic.reintegro = ''; }
  if (tipo.objetivoNuevo && !lic.objetivoNuevo) throw new Error('Elegí el objetivo nuevo.');
  if (tipo.motivo && !lic.motivo) throw new Error('Completá el motivo.');
  if (lic.emailEmpleado && !RE_MAIL_.test(lic.emailEmpleado)) throw new Error('El email del vigilador no es válido.');
  if (!firmaValida_(d.firmaSup)) throw new Error('Falta la firma del supervisor.');

  const firmaEmp = firmaValida_(d.firmaEmp) ? d.firmaEmp : '';
  if (tipo.firmaEmpleado === 'SI' && !firmaEmp) throw new Error('Falta la firma del vigilador.');
  if (tipo.firmaEmpleado === 'OPCIONAL' && !firmaEmp && !lic.empleadoAusente) throw new Error('Falta la firma del vigilador (o marcá que no está presente).');
  if (firmaEmp && !lic.aclEmp) lic.aclEmp = lic.nombre;

  const adjIn = Array.isArray(d.adjuntos) ? d.adjuntos : [];
  if (adjIn.length > CFG.MAX_ADJUNTOS) throw new Error('Máximo ' + CFG.MAX_ADJUNTOS + ' adjuntos.');
  if (tipo.certificado === 'OBLIGATORIO' && !adjIn.length) throw new Error('Para este tipo de licencia hay que sacar foto o adjuntar el certificado.');
  const adjuntos = adjIn.map(function (a, i) {
    const m = String(a && a.data || '').match(/^data:([\w.+\/-]+);base64,(.+)$/);
    if (!m) throw new Error('El adjunto ' + (i + 1) + ' no es válido.');
    const mime = m[1].toLowerCase();
    if (!/^image\/(jpeg|png|webp|gif)$/.test(mime) && mime !== 'application/pdf') throw new Error('El adjunto ' + (i + 1) + ' debe ser una foto o un PDF.');
    const bytes = Utilities.base64Decode(m[2]);
    if (bytes.length > CFG.MAX_ADJ_BYTES) throw new Error('El adjunto ' + (i + 1) + ' supera los 8 MB.');
    return { mime: mime, bytes: bytes, b64: m[2], nombre: limpiar_(a.nombre, 80) || ('adjunto' + (i + 1)) };
  });

  lic.razon = razonSocial_(lic.empresa) || lic.empresa;
  lic.titulo = tipo.titulo;
  lic.texto = armarTexto_(tipo, lic);
  lic.firmaEmpleadoTxt = firmaEmp ? 'SI' : (lic.empleadoAusente ? 'NO PRESENTE' : 'NO');

  const reqId = limpiar_(d.reqId, 60);
  const cache = CacheService.getScriptCache();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  const creados = [];
  let guardado = false;
  try {
    if (reqId) { const previo = cache.get('LIC_REQ_' + reqId); if (previo) return JSON.parse(previo); }

    const sh = licSheet_();
    const col = licCols_(sh);
    lic.id = siguienteId_(sh, col['id']);
    const base = 'Lic_' + lic.id + '_' + lic.codigo + '_' + String(lic.nombre).replace(/[^\w]+/g, '_');

    // Adjuntos a Drive
    const adjFolder = adjuntos.length ? carpetaAdj_() : null;
    const adjLinks = [];
    adjuntos.forEach(function (a, i) {
      const ext = a.mime === 'application/pdf' ? 'pdf' : a.mime.split('/')[1].replace('jpeg', 'jpg');
      const f = adjFolder.createFile(Utilities.newBlob(a.bytes, a.mime, base + '_adj' + (i + 1) + '.' + ext));
      compartirLink_(f); creados.push(f);
      a.url = f.getUrl(); a.file = f;
      adjLinks.push(f.getUrl());
    });

    // PDF
    const pdfBlob = licenciaPdf_(lic, d.firmaSup, firmaEmp, adjuntos).setName(base + '.pdf');
    const pdfFile = carpeta_().createFile(pdfBlob);
    compartirLink_(pdfFile); creados.push(pdfFile);
    lic.pdf = pdfFile.getUrl();

    // Registro en la planilla
    const fila = sh.getLastRow() + 1;
    const ancho = sh.getLastColumn();
    const row = new Array(ancho).fill('');
    const set = function (h, v) { if (col[h] >= 0) row[col[h]] = v; };
    set('id', lic.id);
    set('fecha carga', Utilities.formatDate(new Date(), CFG.TZ, 'dd/MM/yyyy HH:mm'));
    set('fecha documento', fechaCorta_(lic.fecha));
    set('supervisor', lic.supervisor); set('usuario', usuario.usuario);
    set('apellido y nombre', lic.nombre); set('legajo', lic.lp); set('dni', lic.dni); set('empresa', lic.empresa);
    set('objetivo', lic.objetivo); set('codigo', lic.codigo); set('tipo', lic.tipo); set('periodo', lic.periodo);
    set('desde', fechaCorta_(lic.desde)); set('hasta', fechaCorta_(lic.hasta)); set('dias', lic.dias);
    set('reintegro', fechaCorta_(lic.reintegro)); set('objetivo nuevo', lic.objetivoNuevo); set('motivo', lic.motivo);
    set('observaciones', lic.observaciones); set('email empleado', lic.emailEmpleado);
    set('firma empleado', lic.firmaEmpleadoTxt); set('pdf', lic.pdf); set('adjuntos', adjLinks.join('\n'));
    set('estado', 'VIGENTE');
    ['legajo', 'dni', 'fecha documento', 'desde', 'hasta', 'reintegro', 'periodo'].forEach(function (h) {
      if (col[h] >= 0) sh.getRange(fila, col[h] + 1).setNumberFormat('@');
    });
    sh.getRange(fila, 1, 1, ancho).setValues([row]);
    guardado = true;

    // Mail
    let mail = '', enviadoA = '';
    try {
      const r = enviarLicenciaMail_(lic, pdfBlob, adjuntos, usuario, '');
      mail = r.msg; enviadoA = r.lista;
    } catch (e) { mail = 'La licencia quedó guardada, pero no se pudo enviar el email: ' + e.message; }
    if (col['enviado a'] >= 0 && enviadoA) sh.getRange(fila, col['enviado a'] + 1).setValue(enviadoA);

    if (lic.emailEmpleado) {
      try { const a = actualizarEmailPersonal_(lic.dni, lic.emailEmpleado); if (a) mail += ' ' + a; }
      catch (e) { mail += ' No se pudo actualizar el email en Personal: ' + e.message; }
    }

    const res = { ok: true, id: lic.id, pdf: lic.pdf, mail: mail.trim(), nombre: lic.nombre, tipo: lic.tipo };
    if (reqId) cache.put('LIC_REQ_' + reqId, JSON.stringify(res), 21600);
    return res;
  } catch (e) {
    if (!guardado) creados.forEach(function (f) { try { f.setTrashed(true); } catch (_) { /* nada */ } });
    throw e;
  } finally {
    lock.releaseLock();
  }
}

/* =========================================================
   MAIL
   ========================================================= */

/**
 * Para: el vigilador (si tiene email) – si no, el administrador.
 * CC: supervisor que inició sesión, administrador (Config EMAIL_ADMIN) y RRHH_1..3.
 * Si "soloA" viene con un email, se reenvía solo a esa dirección (con copia al supervisor).
 */
function enviarLicenciaMail_(lic, pdfBlob, adjuntos, usuario, soloA) {
  const cfg = config_();
  const usados = {};
  const unico = function (m) {
    m = String(m || '').trim(); const k = m.toLowerCase();
    if (!m || !RE_MAIL_.test(m) || usados[k]) return ''; usados[k] = true; return m;
  };
  let para, cc = [];
  if (soloA) {
    para = unico(soloA);
    if (!para) throw new Error('El email no es válido: ' + soloA);
    [usuario.email].forEach(function (m) { const u = unico(m); if (u) cc.push(u); });
  } else {
    para = unico(lic.emailEmpleado) || unico(cfg.EMAIL_ADMIN);
    [usuario.email, cfg.EMAIL_ADMIN, cfg.RRHH_1, cfg.RRHH_2, cfg.RRHH_3].forEach(function (m) { const u = unico(m); if (u) cc.push(u); });
  }
  if (!para) throw new Error('No hay ningún destinatario de email válido.');

  const periodoTxt = lic.desde ? (lic.hasta ? fechaCorta_(lic.desde) + ' al ' + fechaCorta_(lic.hasta) + ' (' + lic.dias + ' días)' : 'desde ' + fechaCorta_(lic.desde)) : '';
  const asunto = 'Delben - ' + lic.tipo + ' N° ' + lic.id + ' - ' + lic.nombre;
  const html =
    '<p>Se adjunta la notificación de <b>' + esc_(lic.tipo) + '</b> firmada.</p>' +
    '<p><b>N°:</b> ' + esc_(lic.id) +
    '<br><b>Vigilador:</b> ' + esc_(lic.nombre) + ' · Legajo ' + esc_(lic.lp) + ' · ' + esc_(lic.empresa) +
    '<br><b>Objetivo:</b> ' + esc_(lic.objetivo) +
    (lic.periodo ? '<br><b>Período:</b> ' + esc_(lic.periodo) : '') +
    (periodoTxt ? '<br><b>Fechas:</b> ' + esc_(periodoTxt) : '') +
    (lic.reintegro ? '<br><b>Reintegro:</b> ' + esc_(fechaCorta_(lic.reintegro)) : '') +
    (lic.objetivoNuevo ? '<br><b>Objetivo nuevo:</b> ' + esc_(lic.objetivoNuevo) : '') +
    (lic.motivo ? '<br><b>Motivo:</b> ' + esc_(lic.motivo) : '') +
    '<br><b>Cargado por:</b> ' + esc_(lic.supervisor) + '</p>' +
    (lic.firmaEmpleadoTxt === 'NO PRESENTE' ? '<p style="color:#a0001c"><b>El vigilador no estaba presente para firmar.</b></p>' : '');

  const attachments = [pdfBlob];
  let total = pdfBlob.getBytes().length;
  (adjuntos || []).forEach(function (a) {
    if (total + a.bytes.length > 20 * 1024 * 1024) return;   // límite de Gmail: los que no entran van como link (están en el PDF)
    total += a.bytes.length;
    attachments.push(a.file ? a.file.getBlob() : Utilities.newBlob(a.bytes, a.mime, a.nombre));
  });

  const opts = { htmlBody: html, attachments: attachments, name: CFG.APP_TITLE };
  if (cc.length) opts.cc = cc.join(',');
  try {
    GmailApp.sendEmail(para, asunto, 'Se adjunta la notificación de ' + lic.tipo + ' N° ' + lic.id + ' de ' + lic.nombre + '.', opts);
  } catch (e) {
    throw new Error('Gmail no pudo enviar el PDF a ' + para + (cc.length ? ' (CC: ' + cc.join(', ') + ')' : '') + ': ' + (e && e.message || e));
  }
  const lista = [para].concat(cc).join(', ');
  return { msg: 'PDF enviado a ' + para + (cc.length ? ' con copia a ' + cc.join(', ') : '') + '.', lista: lista };
}

/* =========================================================
   PDF A4 (calco del formulario en papel)
   ========================================================= */

function logoKtlSrc_() { return 'data:image/jpeg;base64,' + LOGO_KTL_B64; }

function licenciaPdf_(lic, firmaSup, firmaEmp, adjuntos) {
  const cfg = config_();
  const ciudad = cfg.CIUDAD || 'Buenos Aires';
  const fechaDoc = ciudad + ', ' + fechaLarga_(lic.fecha).replace(/^0/, '') + '.-';
  const sello = Utilities.formatDate(new Date(), CFG.TZ, 'dd/MM/yyyy HH:mm:ss');
  const P = 'font-size:14px;line-height:1.55;margin:0;';
  const lineaFirma = function (img, leyenda, acl) {
    return '<table style="width:100%;border-collapse:collapse;margin-top:6px"><tr><td style="width:52%"></td>' +
      '<td style="text-align:center;vertical-align:bottom">' +
        '<div style="height:84px;line-height:84px">' + (img ? '<img src="' + img + '" style="max-height:80px;max-width:280px;vertical-align:bottom">' : '&nbsp;') + '</div>' +
        '<div style="border-top:1.5px dotted #000;padding-top:3px;font-size:13px">' + leyenda + '</div>' +
        (acl ? '<div style="font-size:11px;color:#222;margin-top:2px">' + acl + '</div>' : '') +
      '</td></tr></table>';
  };

  const datos =
    '<p style="' + P + 'font-weight:bold;font-size:15px;margin-top:18px">' + esc_(lic.razon) + '</p>' +
    '<p style="' + P + 'margin-top:4px">EMPLEADO: ' + esc_(lic.nombre) + '&nbsp;&nbsp;&nbsp;&nbsp;Legajo: ' + esc_(lic.lp) +
      '&nbsp;&nbsp;&nbsp;&nbsp;DNI: ' + esc_(lic.dni) + '</p>' +
    '<p style="' + P + 'margin-top:6px">OBJETIVO: ' + esc_(lic.objetivo) + '</p>' +
    (lic.periodo || lic.desde ? '<p style="' + P + 'margin-top:6px;font-size:12px;color:#333">' +
      (lic.periodo ? 'Período: <b>' + esc_(lic.periodo) + '</b>&nbsp;&nbsp;&nbsp;' : '') +
      (lic.desde ? 'Desde: <b>' + fechaCorta_(lic.desde) + '</b>&nbsp;&nbsp;&nbsp;' : '') +
      (lic.hasta ? 'Hasta: <b>' + fechaCorta_(lic.hasta) + '</b>&nbsp;&nbsp;&nbsp;Días: <b>' + lic.dias + '</b>&nbsp;&nbsp;&nbsp;Reintegro: <b>' + fechaCorta_(lic.reintegro) + '</b>' : '') +
      '</p>' : '');

  const adjImg = (adjuntos || []).filter(function (a) { return a.mime.indexOf('image/') === 0; });
  const adjPdf = (adjuntos || []).filter(function (a) { return a.mime === 'application/pdf'; });

  const firmaEmpBloque = firmaEmp
    ? lineaFirma(firmaEmp, 'Firma del Empleado', esc_(lic.aclEmp) + (lic.dniEmpFirma ? ' · DNI ' + esc_(lic.dniEmpFirma) : ''))
    : lineaFirma('', 'Firma del Empleado', lic.empleadoAusente ? '<b>El empleado no se encontraba presente al momento de la notificación.</b>' : '');

  let html =
    '<html><head><meta charset="utf-8"><style>@page{size:A4 portrait;margin:0}</style></head>' +
    '<body style="font-family:Arial,Helvetica,sans-serif;color:#000;margin:0;padding:38px 56px 30px">' +

    '<table style="width:100%;border-collapse:collapse"><tr>' +
      '<td style="vertical-align:top;width:40%"><img src="' + logoKtlSrc_() + '" height="70"></td>' +
      '<td style="vertical-align:bottom;text-align:right;font-weight:bold;font-size:15px">' + esc_(lic.razon) + '</td>' +
    '</tr></table>' +

    '<div style="text-align:center;margin:26px 0 6px"><span style="font-size:19px;font-weight:bold;text-decoration:underline">' + esc_(lic.titulo) + '</span></div>' +

    datos +

    '<p style="' + P + 'text-align:justify;margin-top:16px">' + esc_(lic.texto) + '</p>' +
    (lic.observaciones ? '<p style="' + P + 'margin-top:8px;font-size:12px"><b>Observaciones:</b> ' + esc_(lic.observaciones) + '</p>' : '') +
    (adjuntos && adjuntos.length ? '<p style="' + P + 'margin-top:8px;font-size:12px"><b>Documentación adjunta:</b> ' + adjuntos.length +
      (adjuntos.length === 1 ? ' archivo' : ' archivos') + (adjImg.length ? ' (las fotos van en las hojas siguientes)' : '') + '.</p>' : '') +

    '<p style="' + P + 'margin-top:20px">Sin otro particular, salúdalo atte.</p>' +
    '<p style="' + P + 'margin-top:6px">' + esc_(fechaDoc) + '</p>' +

    lineaFirma(firmaSup, 'Firma y Sello del Supervisor', esc_(lic.aclSup)) +

    '<p style="' + P + 'margin-top:26px">Señores: ' + esc_(lic.razon) + '</p>' +
    '<p style="' + P + 'margin-top:10px;padding-left:120px">Me notifico de la comunicación que antecede, tomando debida nota. ---------</p>' +
    '<p style="' + P + 'margin-top:12px">' + esc_(fechaDoc) + '</p>' +

    firmaEmpBloque +

    '<p style="font-size:8px;color:#555;margin:22px 0 0">' + esc_(lic.tipo) + ' N° ' + esc_(lic.id) +
      ' · Firmado digitalmente el ' + sello + ' · Registrado por ' + esc_(lic.supervisor) +
      (adjPdf.length ? ' · PDF adjuntos: ' + adjPdf.map(function (a) { return esc_(a.nombre); }).join(', ') : '') + '</p>' +
    '<p style="text-align:center;font-size:8px;color:#333;margin:10px 0 0;border-top:1px solid #999;padding-top:6px">' +
      'KTL SEGURIDAD · (011) 4000-9600 · www.ktl-seguridad.com<br>Adolfo Alsina 1360 6º piso (C1088AAJ) C.A.B.A., Argentina</p>';

  // Una hoja por cada foto del certificado
  adjImg.forEach(function (a, i) {
    html += '<div style="page-break-before:always;padding-top:4px">' +
      '<table style="width:100%;border-collapse:collapse"><tr>' +
        '<td><img src="' + logoKtlSrc_() + '" height="40"></td>' +
        '<td style="text-align:right;font-size:12px"><b>' + esc_(lic.tipo) + ' N° ' + esc_(lic.id) + '</b><br>' + esc_(lic.nombre) +
          ' · Legajo ' + esc_(lic.lp) + '</td></tr></table>' +
      '<div style="font-size:13px;font-weight:bold;margin:10px 0 8px">Documentación adjunta ' + (i + 1) + ' de ' + adjImg.length + '</div>' +
      '<div style="text-align:center"><img src="data:' + a.mime + ';base64,' + a.b64 + '" style="max-width:100%;max-height:950px"></div>' +
      '</div>';
  });

  html += '</body></html>';
  return Utilities.newBlob(html, 'text/html', 'licencia.html').getAs('application/pdf');
}

/* =========================================================
   CONSULTAS
   ========================================================= */

function leerLicencias_() {
  const sh = licSheet_();
  const n = sh.getLastRow();
  if (n < 2) return [];
  const col = licCols_(sh);
  const v = sh.getRange(2, 1, n - 1, sh.getLastColumn()).getDisplayValues();
  const g = function (r, h) { return col[h] >= 0 ? String(r[col[h]] || '').trim() : ''; };
  const out = [];
  v.forEach(function (r, i) {
    const id = g(r, 'id');
    if (!id) return;
    out.push({
      fila: i + 2, id: id, fechaCarga: g(r, 'fecha carga'), fecha: g(r, 'fecha documento'), fechaIso: valorAIso_(g(r, 'fecha documento')),
      supervisor: g(r, 'supervisor'), nombre: g(r, 'apellido y nombre'), lp: g(r, 'legajo'), dni: g(r, 'dni'),
      empresa: g(r, 'empresa'), objetivo: g(r, 'objetivo'), codigo: g(r, 'codigo'), tipo: g(r, 'tipo'),
      periodo: g(r, 'periodo'), desde: g(r, 'desde'), hasta: g(r, 'hasta'), dias: g(r, 'dias'), reintegro: g(r, 'reintegro'),
      desdeIso: valorAIso_(g(r, 'desde')), hastaIso: valorAIso_(g(r, 'hasta')),
      objetivoNuevo: g(r, 'objetivo nuevo'), motivo: g(r, 'motivo'), observaciones: g(r, 'observaciones'),
      emailEmpleado: g(r, 'email empleado'), firmaEmpleado: g(r, 'firma empleado'), pdf: g(r, 'pdf'),
      adjuntos: g(r, 'adjuntos').split(/\s+/).filter(function (x) { return /^https?:/.test(x); }),
      estado: g(r, 'estado') || 'VIGENTE', enviadoA: g(r, 'enviado a')
    });
  });
  out.sort(function (a, b) { return Number(b.id) - Number(a.id); });
  return out;
}

function listarLicencias(token) {
  validarSesion_(token);
  return leerLicencias_();
}

/**
 * Licencias de una persona (por DNI o legajo). Queda lista para usarla desde
 * Novedades del Personal / Ausencias (clic en el nombre del vigilador).
 */
function licenciasDePersona(token, dniOLegajo, empresa) {
  validarSesion_(token);
  const d = soloDigitos_(dniOLegajo), e = norm_(empresa);
  return leerLicencias_().filter(function (l) {
    if (d && soloDigitos_(l.dni) === d) return true;
    return !!d && l.lp === String(dniOLegajo).trim() && (!e || norm_(l.empresa) === e);
  });
}

function reenviarLicencia(token, id, email) {
  const usuario = validarSesion_(token);
  email = limpiar_(email, 150);
  if (!RE_MAIL_.test(email)) throw new Error('Ingresá un email válido.');
  const l = leerLicencias_().filter(function (x) { return String(x.id) === String(id); })[0];
  if (!l) throw new Error('No se encontró la licencia N° ' + id + '.');
  const pdfId = driveId_(l.pdf);
  if (!pdfId) throw new Error('La licencia no tiene PDF guardado.');
  const pdfBlob = DriveApp.getFileById(pdfId).getBlob();
  const adj = l.adjuntos.map(function (u) {
    try { const f = DriveApp.getFileById(driveId_(u)); return { file: f, bytes: f.getBlob().getBytes(), mime: f.getMimeType(), nombre: f.getName() }; }
    catch (e) { return null; }
  }).filter(Boolean);
  const lic = {
    id: l.id, tipo: l.tipo, nombre: l.nombre, lp: l.lp, empresa: l.empresa, objetivo: l.objetivo, periodo: l.periodo,
    desde: l.desdeIso, hasta: l.hastaIso, dias: l.dias, reintegro: valorAIso_(l.reintegro), objetivoNuevo: l.objetivoNuevo,
    motivo: l.motivo, supervisor: usuario.nombre || usuario.usuario, firmaEmpleadoTxt: l.firmaEmpleado, emailEmpleado: ''
  };
  return { ok: true, mail: enviarLicenciaMail_(lic, pdfBlob, adj, usuario, email).msg };
}

/** Devuelve un PDF o foto guardado (solo de las carpetas de Licencias) para verlo dentro de la app. */
function obtenerArchivoBase64(token, referencia) {
  validarSesion_(token);
  const id = driveId_(referencia);
  if (!id) throw new Error('Archivo no válido.');
  const file = DriveApp.getFileById(id);
  const permitidas = [prop_('DRIVE_FOLDER_ID'), prop_('DRIVE_ADJ_ID')];
  const padres = file.getParents();
  let ok = false;
  while (padres.hasNext()) if (permitidas.indexOf(padres.next().getId()) >= 0) ok = true;
  if (!ok) throw new Error('El archivo no pertenece a las carpetas de Licencias.');
  return { nombre: file.getName(), mime: file.getMimeType(), base64: Utilities.base64Encode(file.getBlob().getBytes()) };
}

/* =========================================================
   DIAGNÓSTICO (ejecutar desde el editor y mirar el Registro de ejecución)
   ========================================================= */

function diagnosticoSistema() {
  const res = [];
  function paso(nombre, fn) {
    try { res.push('OK   ' + nombre + ': ' + fn()); } catch (e) { res.push('ERROR ' + nombre + ': ' + (e && e.message || e)); }
  }
  paso('Planilla de Licencias', function () { return licSs_().getName(); });
  paso('Hoja Licencias', function () { const sh = licSheet_(); return (sh.getLastRow() - 1) + ' registros, próximo N° ' + siguienteId_(sh, licCols_(sh)['id']); });
  paso('Tipos de licencia', function () { return tipos_().map(function (t) { return t.codigo; }).join(', '); });
  paso('Config / destinatarios', function () { const c = config_(); return [c.EMAIL_ADMIN, c.RRHH_1, c.RRHH_2, c.RRHH_3].filter(String).join(', ') || '(sin emails)'; });
  paso('Personal (Stock Manager)', function () { return empleados_().length + ' empleados (sin BAJA)'; });
  paso('Objetivos', function () { return objetivos_().length + ' objetivos'; });
  paso('Usuarios', function () { return leerTabla_(hoja_(fuenteSs_(), CFG.AUTH_SHEET), authDefs_()).rows.length + ' filas'; });
  paso('Carpetas de Drive', function () { return carpeta_().getName() + ' / ' + carpetaAdj_().getName(); });
  paso('PDF de prueba', function () {
    const b = licenciaPdf_({ id: 0, razon: 'L.E. GUYET', titulo: 'PERIODO DE DESCANSO ANUAL', nombre: 'PRUEBA', lp: '1', dni: '1',
      objetivo: 'PRUEBA', texto: 'Texto de prueba.', fecha: fechaAIso_(new Date()), tipo: 'Vacaciones', supervisor: 'Prueba', aclSup: 'Prueba' }, '', '', []);
    return b.getBytes().length + ' bytes';
  });
  paso('Permiso de Gmail', function () { GmailApp.getAliases(); return 'autorizado (cuenta ' + Session.getEffectiveUser().getEmail() + ')'; });
  Logger.log(res.join('\n'));
  return res;
}
