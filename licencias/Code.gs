    licenciasDePersona: licenciasDePersona,
    reenviarLicencia: reenviarLicencia,
    obtenerArchivoBase64: obtenerArchivoBase64
  };
}

function doGet(e) {
  const p = (e && e.parameter) || {};
  if (String(p.rpc || '') === '1') {
    const id = String(p.id || ''), callback = String(p.callback || '');
    const okCb = /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(callback);
    try {
      if (!okCb) throw new Error('Callback RPC inválido.');
      const fn = String(p.fn || ''), args = JSON.parse(String(p.args || '[]'));
      if (!/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(fn)) throw new Error('Función RPC inválida.');
      if (!Array.isArray(args)) throw new Error('Argumentos RPC inválidos.');
      const target = rpcTabla_()[fn];
      if (typeof target !== 'function') throw new Error('Función no disponible: ' + fn);
      const payload = JSON.stringify({ __delbenLicRpc: true, id: id, ok: true, result: target.apply(null, args) });
      return ContentService.createTextOutput(callback + '(' + payload + ');').setMimeType(ContentService.MimeType.JAVASCRIPT);
    } catch (err) {
      if (!okCb) return ContentService.createTextOutput('/* RPC inválido */').setMimeType(ContentService.MimeType.JAVASCRIPT);
      const payload = JSON.stringify({ __delbenLicRpc: true, id: id, ok: false, error: String(err && err.message || err) });
      return ContentService.createTextOutput(callback + '(' + payload + ');').setMimeType(ContentService.MimeType.JAVASCRIPT);
    }
  }
  return HtmlService.createHtmlOutputFromFile('index')
    .setTitle(CFG.APP_TITLE)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** Puente RPC por POST (iframe oculto) para el guardado con firmas y fotos desde GitHub Pages. */
function doPost(e) {
  let id = '';
  try {
    let fn = '', args = [];
    if (e && e.parameter && e.parameter.fn) {
      fn = String(e.parameter.fn || '');
      id = String(e.parameter.id || '');
      args = JSON.parse(String(e.parameter.args || '[]'));
    } else {
      const body = e && e.postData && e.postData.contents ? JSON.parse(e.postData.contents) : {};
      fn = String(body.fn || ''); id = String(body.id || '');
      args = Array.isArray(body.args) ? body.args : [];
    }
    if (!fn || !/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(fn)) throw new Error('Función RPC inválida.');
    const target = rpcTabla_()[fn];
    if (typeof target !== 'function') throw new Error('Función no disponible: ' + fn);
    if (!Array.isArray(args)) args = [];
    return rpcHtmlResponse_(id, true, target.apply(null, args));
  } catch (err) {
    return rpcHtmlResponse_(id, false, String(err && err.message || err));
  }
}

function rpcHtmlResponse_(id, ok, value) {
  const payload = JSON.stringify({
    __delbenLicRpc: true, id: String(id || ''), ok: ok === true,
    result: ok === true ? value : undefined,
    error: ok === true ? undefined : String(value || 'Error del backend de Licencias.')
  });
  const html = '<!doctype html><html><head><meta charset="utf-8"></head><body><script>' +
    'window.top.postMessage(' + payload + ', "https://ferchu17.github.io");<\/script></body></html>';
  return HtmlService.createHtmlOutput(html).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/* =========================================================
